{
  "name": "alien-body",
  "version": "1.6.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/playthrough.mjs",
    "test:branches": "node tests/branches.mjs",
    "test:production": "node tests/production.mjs",
    "test:polish": "node tests/polish.mjs",
    "test:directed": "node tests/directed.mjs",
    "package": "node scripts/python.mjs scripts/package_release.py",
    "test:robot": "node tests/robot.mjs",
    "test:inspection": "node tests/inspection-robustness.mjs",
    "test:motion": "node tests/motion-matrix.mjs",
    "test:enemies": "node tests/enemies.mjs",
    "test:combat": "node tests/combat.mjs",
    "test:guidance": "node tests/guidance.mjs",
    "test:theme": "node tests/theme.mjs",
    "test:appearance": "node tests/appearance.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:server": "node scripts/python.mjs -m unittest discover -s tests -p \"test_*.py\"",
    "check": "npm run lint && npm run format:check && npm test && npm run test:server",
    "verify": "node scripts/verify.mjs",
    "release": "npm run verify && npm run package",
    "test:reliability": "node tests/reliability.mjs",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/*.{js,mjs}\" \"scripts/*.mjs\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/*.{js,mjs}\" \"scripts/*.mjs\" \"*.js\"",
    "test:journey": "node tests/journey.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "vite": "8.3.5"
  },
  "description": "A local-first, four-chapter 3D single-player adventure.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "keywords": [
    "game",
    "threejs",
    "offline",
    "adventure"
  ]
}
